# Copy to .env for local `vercel dev`, or paste each of these into
# Vercel → Project → Settings → Environment Variables for the real deploy.

# --- Auth ---
CMS_USERNAME=admin
# Generate with: node scripts/hash-password.js "your-password-here"
CMS_PASSWORD_HASH=
# Any long random string — used to sign session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Target GitHub repo (the site this CMS edits) ---
# Needs a Personal Access Token with "repo" scope (classic) or
# Contents: Read and write (fine-grained), scoped to just that repo.
GITHUB_TOKEN=
GITHUB_OWNER=dferreiramarques
GITHUB_REPO=bitnikgames
GITHUB_BRANCH=main

# --- Vercel deploy status (optional) ---
# Lets the editor show real "still building" / "done" status after a save
# instead of a fixed-length wait. Without these, api/deploy-status.js
# throws and the frontend falls back to the fixed timer automatically — so
# leaving them empty is fine, this is not required for the CMS to work.
# Create a token at https://vercel.com/account/tokens (no special scope
# needed beyond your own account/team access).
VERCEL_TOKEN=
# Project → Settings → General → "Project ID" on the bitnikgames project
# (NOT this CMS's own project).
VERCEL_PROJECT_ID=
# Only needed if that project lives under a Vercel team, not a personal
# account — Team → Settings → "Team ID".
VERCEL_TEAM_ID=
